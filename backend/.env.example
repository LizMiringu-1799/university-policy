SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# XAMPP MySQL defaults: user "root", no password, port 3306
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=upman_db

CORS_ORIGINS=http://localhost:5173

# RAG. Defaults are in app/config.py; override only if you know why.
# Chunk sizes are characters, sized to the embedding model's 256-token input window
# rather than the LLM context window (docs/design-rag.md §1).
CHROMA_DIR=
RAG_TOP_K=8
# Keeps the embedding model from taking every core during ingestion. run.py sets this
# already; listed here so it is visible when configuring a container.
OMP_NUM_THREADS=1
# OCR (RapidOCR) for scanned PDF pages and directly uploaded images. Turn off if it
# proves too slow or noisy without a code change — see app/rag/ocr.py.
RAG_OCR_ENABLED=true
# Word docs and plain text have no real pages; this many characters makes one pseudo-page.
RAG_PAGE_CHARS=2500

# Answering LLM. Reached over an OpenAI-compatible endpoint, so changing provider is a
# base URL plus a model string and no code change (docs/design-rag.md §9).
# Default is Groq's free tier: sign up at https://console.groq.com, no card required.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# Cited-chunk mean similarity below this marks an answer unanswered. Kept low because
# short queries score lower on cosine similarity even against the right chunk — see the
# comment on RAG_CONFIDENCE_THRESHOLD in app/config.py for the measurements behind this.
RAG_CONFIDENCE_THRESHOLD=0.2
